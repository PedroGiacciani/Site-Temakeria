# Desativa execução de CGI
Options -ExecCGI

# Bloqueia a execução de qualquer arquivo PHP nesta pasta
<FilesMatch "\.(php|php[0-9]|phps|phtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protege arquivos que começam com .ht (como o próprio .htaccess)
<FilesMatch "^.*\.([Hh][Tt][Aa])">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
